---
// Root page redirects to default locale /pt
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/pt" />
    <link rel="canonical" href="https://casadosfilhos.org/pt" />
    <title>Redirecionando para Casa dos Filhos...</title>
    <script is:inline>
      window.location.pathname = '/pt';
    </script>
  </head>
  <body class="bg-[#FAFAFA] flex items-center justify-center min-h-screen text-slate-700 font-sans">
    <div class="text-center p-6 space-y-3">
      <div class="w-12 h-12 border-3 border-rose-800 border-t-transparent rounded-full animate-spin mx-auto"></div>
      <p class="text-sm font-semibold">Carregando Casa dos Filhos...</p>
      <p class="text-xs text-slate-500">Se não for redirecionado automaticamente, <a href="/pt" class="text-rose-800 underline font-bold">clique aqui</a>.</p>
    </div>
  </body>
</html>
