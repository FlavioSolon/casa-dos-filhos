---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'pt' | 'en';
  canonicalUrl?: string;
}

const {
  lang = 'pt',
  title = lang === 'pt'
    ? 'Casa dos Filhos | Apoie Crianças em Manaus/AM'
    : 'Casa dos Filhos | Support Children in Manaus',
  description = lang === 'pt'
    ? 'Doe para a Casa dos Filhos em Manaus/AM e transforme vidas através de educação, esporte, alimentação saudável e acolhimento diário.'
    : 'Support Casa dos Filhos in Manaus, Brazil. Transform children\'s lives through education, sports, nutrition, and loving daily care.',
  canonicalUrl = `https://casa-dos-filhos.netlify.app/${lang}`
} = Astro.props;

const siteUrl = 'https://casa-dos-filhos.netlify.app';
const ogImage = `${siteUrl}/images/hero-kids.jpg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["NGO", "LocalBusiness", "NonprofitOrganization"],
      "@id": `${siteUrl}/#organization`,
      "name": "Casa dos Filhos",
      "alternateName": "@casadosfilhos",
      "legalName": "CASA DOS FILHOS",
      "taxID": "50.842.391/0001-60",
      "url": siteUrl,
      "logo": `${siteUrl}/images/logo.svg`,
      "image": ogImage,
      "description": "Organização sem fins lucrativos em Manaus/AM acolhendo crianças em vulnerabilidade social através de educação, esportes, nutrição e apoio sociofamiliar.",
      "telephone": "+55-92-99176-4615",
      "email": "contato@casadosfilhos.org",
      "priceRange": "$",
      "currenciesAccepted": "BRL, USD, EUR",
      "paymentAccepted": "PIX, Direct Bank Transfer (Sicoob)",
      "openingHours": "Mo-Fr 08:00-17:00",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Zona Norte",
        "addressLocality": "Manaus",
        "addressRegion": "AM",
        "postalCode": "69097-122",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -3.1190275,
        "longitude": -60.0217314
      },
      "areaServed": {
        "@type": "City",
        "name": "Manaus",
        "containedInPlace": {
          "@type": "State",
          "name": "Amazonas"
        }
      },
      "sameAs": [
        "https://www.instagram.com/casadosfilhos/",
        "https://wa.me/5592991764615"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Casa dos Filhos",
      "publisher": {
        "@id": `${siteUrl}/#organization`
      },
      "inLanguage": ["pt-BR", "en-US"]
    }
  ]
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags (Strict 50-60 chars title, 120-160 chars description) -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Casa dos Filhos" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="pt" href={`${siteUrl}/pt`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/pt`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:site_name" content="Casa dos Filhos" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Geographic Micro-tags for Local SEO (Manaus, Amazonas) -->
    <meta name="geo.region" content="BR-AM" />
    <meta name="geo.placename" content="Manaus" />
    <meta name="geo.position" content="-3.119028;-60.021731" />
    <meta name="ICBM" content="-3.119028, -60.021731" />

    <!-- Fonts: Google Fonts Plus Jakarta Sans preconnected -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD Structured Data (LocalBusiness + NGO) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FAFAFA] text-slate-900 selection:bg-rose-100 selection:text-rose-900">
    <Header lang={lang} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
