---
import { Image } from 'astro:assets';
import p21 from '../assets/images/parceiros/partner-21.png';
import pAvif from '../assets/images/parceiros/PDF1_AVIF1.avif';
import p1 from '../assets/images/parceiros/partner-1.jpeg';
import p2 from '../assets/images/parceiros/partner-2.jpeg';
import p3 from '../assets/images/parceiros/partner-3.jpeg';
import p4 from '../assets/images/parceiros/partner-4.jpeg';
import pTake from '../assets/images/parceiros/partner-take.png';

export interface Props {
  lang?: 'pt' | 'en';
}

const { lang = 'pt' } = Astro.props;

const partners = [
  { img: p21, name: "Parceiro 21", darkBg: true, scale: "scale-[3]" },
  { img: pAvif, name: "Parceiro PDF1 AVIF1", darkBg: false },
  { img: p1, name: "Parceiro 1", darkBg: false },
  { img: p2, name: "Parceiro 2", darkBg: false },
  { img: p3, name: "Parceiro 3", darkBg: false },
  { img: p4, name: "Parceiro 4", darkBg: false },
  { img: pTake, name: "Take White", darkBg: true, scale: "scale-[1.6]" }
];

// Schema markup for GEO / AEO / SEO - ItemList for Partners
const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": lang === 'pt' ? "Parceiros Oficiais da Casa dos Filhos" : "Official Partners of Casa dos Filhos",
  "description": lang === 'pt' ? "Lista de empresas e organizações que apoiam a Casa dos Filhos." : "List of companies supporting Casa dos Filhos.",
  "itemListElement": partners.map((partner, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": partner.name,
    "url": "https://casadosfilhos.com/#parceiros"
  }))
};
---

<section id="parceiros" class="py-20 bg-gray-50" aria-labelledby="partners-heading">
  <div class="container mx-auto px-4 md:px-8 max-w-7xl">
    <div class="text-center mb-16">
      <h2 id="partners-heading" class="text-3xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
        {lang === 'en' ? 'Our ' : 'Nossos '}<span class="text-primary-600">{lang === 'en' ? 'Partners' : 'Parceiros'}</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        {lang === 'en' 
          ? 'We deeply appreciate the support of the brands that believe in and strengthen our mission to transform lives.' 
          : 'Agradecemos imensamente o apoio das marcas que acreditam e fortalecem nossa missão de transformar vidas.'}
      </p>
    </div>

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

    <!-- Grid de Parceiros -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 items-center justify-items-center">
      {partners.map((partner) => {
        return (
          <article class={`w-full h-40 md:h-48 rounded-2xl flex items-center justify-center p-6 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 ${partner.darkBg ? 'bg-gray-800' : 'bg-white shadow-md'}`}>
            <Image 
              src={partner.img} 
              alt={lang === 'pt' ? `Logotipo oficial do parceiro ${partner.name}` : `Official logo of partner ${partner.name}`}
              title={lang === 'pt' ? `Parceiro: ${partner.name}` : `Partner: ${partner.name}`}
              loading="lazy"
              decoding="async"
              class={`max-w-full max-h-full object-contain filter hover:brightness-110 transition-all duration-300 ${partner.scale || ''}`}
            />
          </article>
        )
      })}
    </div>
  </div>
</section>
