---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-white pt-16 pb-12 border-t border-slate-800" itemscope itemtype="https://schema.org/NGO">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Grid: Bio, Quick Links, Contacts -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-slate-800">
      <!-- Col 1: Brand & Bio -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 relative shrink-0">
            <img src="/images/logo.svg" alt="Casa dos Filhos" class="w-full h-full object-contain" width="48" height="48" itemprop="logo" />
          </div>
          <div>
            <span class="text-xl font-black text-white block" itemprop="name">Casa dos Filhos</span>
            <span class="text-xs font-bold text-rose-400 block uppercase tracking-wider">Manaus • Amazonas</span>
          </div>
        </div>

        <p class="text-sm text-slate-400 leading-relaxed max-w-md font-medium" itemprop="description">
          {t('footer.description')}
        </p>

        <!-- Semantic Address and Tax ID Box -->
        <address class="not-italic p-4 bg-slate-900/90 rounded-2xl border border-slate-800 text-xs text-slate-300 space-y-1.5 block" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
          <div class="font-bold text-white flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>{t('footer.verifiedNgo')}</span>
          </div>
          <p class="font-mono text-slate-400">CNPJ: <span itemprop="taxID">50.842.391/0001-60</span></p>
          <p class="text-slate-300">
            <span itemprop="addressLocality">Manaus</span>, 
            <span itemprop="addressRegion">Amazonas</span> - 
            <span itemprop="addressCountry">Brasil</span> • CEP: 
            <span itemprop="postalCode">69097-122</span>
          </p>
        </address>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-sm font-black uppercase tracking-wider text-rose-400">
          {t('footer.quickLinks')}
        </h4>
        <ul class="space-y-2.5 text-sm text-slate-300 font-medium">
          <li><a href="#sobre" class="hover:text-white transition-colors">{t('nav.about')}</a></li>
          <li><a href="#metodologia" class="hover:text-white transition-colors">{lang === 'pt' ? 'Metodologia' : 'Methodology'}</a></li>
          <li><a href="#atividades" class="hover:text-white transition-colors">{t('nav.activities')}</a></li>
          <li><a href="#impacto" class="hover:text-white transition-colors">{t('nav.impact')}</a></li>
          <li><a href="#dados-bancarios" class="hover:text-white transition-colors">{t('nav.transparency')}</a></li>
          <li><a href="#galeria" class="hover:text-white transition-colors">{t('nav.gallery')}</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">{t('nav.faq')}</a></li>
        </ul>
      </div>

      <!-- Col 3: Direct Contact & Banking quick look -->
      <div class="lg:col-span-4 space-y-4">
        <h4 class="text-sm font-black uppercase tracking-wider text-rose-400">
          {t('footer.contact')}
        </h4>
        
        <div class="space-y-3 text-sm">
          <!-- WhatsApp & Phone Link with E.164 +55 Format -->
          <a
            href="tel:+5592991764615"
            itemprop="telephone"
            class="flex items-center gap-3 p-3 rounded-2xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-850 transition-all text-slate-200"
          >
            <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.96.524 1.769.814 2.8.814 3.18 0 5.768-2.587 5.768-5.766 0-3.18-2.588-5.766-5.772-5.766zm9.969 5.828c0 5.518-4.482 10-10 10-1.745 0-3.39-.45-4.834-1.246l-5.166 1.354 1.378-5.035c-.886-1.504-1.378-3.238-1.378-5.073 0-5.518 4.482-10 10-10 5.518 0 10 4.482 10 10z"/>
              </svg>
            </div>
            <div>
              <span class="block text-xs text-slate-400 font-bold">Telefone / WhatsApp</span>
              <span class="font-semibold text-white">+55 (92) 99176-4615</span>
            </div>
          </a>

          <!-- Instagram Link -->
          <a
            href="https://www.instagram.com/casadosfilhos/"
            target="_blank"
            rel="noopener noreferrer"
            itemprop="sameAs"
            class="flex items-center gap-3 p-3 rounded-2xl bg-slate-900 border border-slate-800 hover:border-rose-500/50 hover:bg-slate-850 transition-all text-slate-200"
          >
            <div class="w-8 h-8 rounded-xl bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div>
              <span class="block text-xs text-slate-400 font-bold">Instagram Oficial</span>
              <span class="font-semibold text-white">@casadosfilhos</span>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Developer Credit -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-slate-400 font-medium">
      <p>{t('footer.copyright', { year: currentYear.toString() })}</p>

      <!-- Developer Credit with Social Links -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 text-slate-400 bg-slate-900/80 px-4 py-2 rounded-full border border-slate-800 shadow-xs">
        <span class="flex items-center gap-1.5">
          <span>{lang === 'pt' ? 'Desenvolvido com' : 'Crafted with'}</span>
          <svg class="w-3.5 h-3.5 text-rose-500 fill-current inline animate-pulse" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
          </svg>
          <span>{lang === 'pt' ? 'por' : 'by'}</span>
          <a
            href="https://flavio-solon.lovable.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-slate-200 hover:text-amber-400 transition-colors underline decoration-slate-600 hover:decoration-amber-400 underline-offset-2"
          >
            Flávio Sólon
          </a>
        </span>

        <span class="text-slate-700">•</span>

        <!-- Social Icons Group -->
        <div class="flex items-center gap-1">
          <!-- Portfolio -->
          <a
            href="https://flavio-solon.lovable.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-1 text-slate-400 hover:text-amber-400 hover:bg-slate-800 rounded-full transition-all"
            title="Portfólio • Flávio Sólon"
            aria-label="Portfólio Flávio Sólon"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/fl%C3%A1vio-s-8941b9212/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-1 text-slate-400 hover:text-sky-400 hover:bg-slate-800 rounded-full transition-all"
            title="LinkedIn • Flávio Sólon"
            aria-label="LinkedIn Flávio Sólon"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>

          <!-- GitHub -->
          <a
            href="https://github.com/FlavioSolon"
            target="_blank"
            rel="noopener noreferrer"
            class="p-1 text-slate-400 hover:text-white hover:bg-slate-800 rounded-full transition-all"
            title="GitHub • Flávio Sólon"
            aria-label="GitHub Flávio Sólon"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://www.instagram.com/solonflavi/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-1 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-full transition-all"
            title="Instagram • Flávio Sólon"
            aria-label="Instagram Flávio Sólon"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <span>Manaus/AM, Brasil</span>
        <span>•</span>
        <a href="#sobre" class="hover:text-slate-200 transition-colors">Voltar ao topo ↑</a>
      </div>
    </div>
  </div>
</footer>
